{
  "name": "ollama-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that lets an orchestrating agent delegate self-contained subtasks to a local model running under Ollama",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ollama",
    "llm",
    "local-llm",
    "claude-code",
    "agent",
    "delegation"
  ],
  "homepage": "https://github.com/RidderH/ollama-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/RidderH/ollama-mcp-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RidderH/ollama-mcp-server.git"
  },
  "license": "MIT",
  "author": "Knight B.V.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ollama-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test tests/*.test.js",
    "prepublishOnly": "npm run clean && npm run build",
    "test:evals": "node --test evals/lib/*.test.mjs evals/probes/*.test.mjs",
    "evals": "node evals/run.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "diff": "^8.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
